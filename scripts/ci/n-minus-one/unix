#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
work_root="${RUNNER_TEMP:?RUNNER_TEMP is required}/labby-n-minus-one/unix"
install_dir="$work_root/bin"
labby_home="$work_root/home"
state_digest="$work_root/persisted-state.sha256"
pid_file="$work_root/labby.pid"

seed_persisted_state() {
    mkdir -p "$labby_home"
    cat >"$labby_home/config.toml" <<'EOF'
config_version = 1
[gateway]
extra_stdio_commands = ["labby"]
[[upstream]]
id = "n-minus-one"
name = "n-minus-one"
transport = "stdio"
command = "labby"
args = ["mcp"]
EOF
    printf 'LABBY_MCP_HTTP_TOKEN=%064d\n' 0 >"$labby_home/.env"
    chmod 600 "$labby_home/.env"
    python3 "$repo_root/scripts/ci/n-minus-one-durable-state.py" seed "$labby_home"
    (cd "$labby_home" && sha256sum config.toml .env) >"$state_digest"
}

verify_persisted_state() {
    python3 "$repo_root/scripts/ci/n-minus-one-durable-state.py" verify "$labby_home"
    (cd "$labby_home" && sha256sum -c "$state_digest")
    PATH="$install_dir:$PATH" LABBY_HOME="$labby_home" "$install_dir/labby" --json gateway list | grep -Fq '"id": "n-minus-one"'
}

verify_version() {
    local expected=${1#v}
    "$install_dir/labby" --version | grep -Fq "$expected"
}

verify_provenance() {
    : "${LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE:?exact candidate archive is required}"
    : "${LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE_SHA256:?exact candidate archive SHA-256 is required}"
    "$repo_root/scripts/ci/verify-and-activate-release.sh" \
        --repo "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}" --workflow release.yml \
        --ref "${GITHUB_REF:?GITHUB_REF is required}" \
        --artifact "$LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE" -- true
}

start_service() {
    PATH="$install_dir:$PATH" LABBY_HOME="$labby_home" nohup "$install_dir/labby" serve \
        >"$work_root/service.log" 2>&1 &
    echo $! >"$pid_file"
    for _ in {1..50}; do curl -fsS http://127.0.0.1:8765/ready >/dev/null && return; sleep 0.2; done
    echo 'service did not become ready' >&2; return 1
}

stop_service() {
    [[ -f "$pid_file" ]] || return 0
    kill "$(cat "$pid_file")" 2>/dev/null || true
    wait "$(cat "$pid_file")" 2>/dev/null || true
    rm -f "$pid_file"
}

authenticated_action() {
    [[ -f "$pid_file" ]] || start_service
    token=$(sed -n 's/^LABBY_MCP_HTTP_TOKEN=//p' "$labby_home/.env")
    curl -fsS -X POST -H "Authorization: Bearer $token" \
        -H 'Content-Type: application/json' \
        --data '{"action":"gateway.list","params":{}}' \
        http://127.0.0.1:8765/v1/gateway >/dev/null
}

case "${1:-}" in
    install-previous)
        mkdir -p "$work_root"
        LABBY_INSTALL_DIR="$install_dir" LABBY_INSTALL_VERSION="$LABBY_PREVIOUS_VERSION" \
            LABBY_ALLOW_SOURCE_FALLBACK=0 sh "$repo_root/scripts/install.sh"
        ;;
    seed-state) start_service; seed_persisted_state; stop_service ;;
    verify-previous) verify_version "$LABBY_PREVIOUS_VERSION"; verify_persisted_state ;;
    verify-provenance) verify_provenance ;;
    upgrade)
        : "${LABBY_N_MINUS_ONE_CANDIDATE_BINARY:?exact candidate binary is required}"
        : "${LABBY_N_MINUS_ONE_CANDIDATE_SHA256:?exact candidate SHA-256 is required}"
        "$repo_root/scripts/ci/verify-and-activate-release.sh" \
            --repo "$GITHUB_REPOSITORY" --workflow release.yml --ref "$GITHUB_REF" \
            --artifact "${LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE:?exact candidate archive is required}" -- \
            env LABBY_INSTALL_DIR="$install_dir" LABBY_INSTALL_VERSION="$LABBY_CANDIDATE_VERSION" \
            LABBY_INSTALL_LOCAL_BINARY="$LABBY_N_MINUS_ONE_CANDIDATE_BINARY" \
            LABBY_INSTALL_LOCAL_SHA256="$LABBY_N_MINUS_ONE_CANDIDATE_SHA256" sh "$repo_root/scripts/install.sh"
        ;;
    verify-candidate) verify_version "$LABBY_CANDIDATE_VERSION"; verify_persisted_state ;;
    authenticated-action) authenticated_action ;;
    restart) stop_service; start_service ;;
    verify-restart) verify_version "$LABBY_CANDIDATE_VERSION"; verify_persisted_state; authenticated_action ;;
    rollback) stop_service; LABBY_INSTALL_DIR="$install_dir" LABBY_INSTALL_ROLLBACK=1 sh "$repo_root/scripts/install.sh" ;;
    verify-rollback) verify_version "$LABBY_PREVIOUS_VERSION"; verify_persisted_state ;;
    *) echo "unknown stage: ${1:-}" >&2; exit 64 ;;
esac
