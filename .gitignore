# ── Secrets — ONLY .env.example may be committed ─────────────────────────────
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example
!apps/palette-tauri/scripts/desktop-smoke.env.example
# Use /config.toml (root-anchored) so .cargo/config.toml is NOT excluded.
/config.toml
# The gateway writes sibling <config>.lock and <config>.mutation.lock sidecars
# next to whatever config it opens. Running labby/tests from the repo root can
# therefore drop both here; neither runtime synchronization file belongs in git.
/config.toml.lock
/config.toml.mutation.lock
.broadcastr
# ── Runtime artifacts ────────────────────────────────────────────────────────
/logs/
!apps/web/app/(admin)/logs/
!apps/web/app/(admin)/logs/page.tsx
!apps/web/components/logs/
!apps/web/components/logs/*.tsx
*.runtime.json
/artifacts/
backups/
*.log
*.pid
*.bak
*.bak-*
*.tmp
*.temp
.tmp-*
*.mutation.lock
erl_crash.dump

