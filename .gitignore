# ── Secrets — ONLY .env.example may be committed ─────────────────────────────
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example
!apps/palette-tauri/scripts/desktop-smoke.env.example
# Use /config.toml (root-anchored) so .cargo/config.toml is NOT excluded.
/config.toml
# The gateway writes a sibling <config>.lock next to whatever config it opens
# (see lock_path() in crates/labby-gateway/src/gateway/config.rs). Running
# labby from the repo root therefore drops /config.toml.lock here; ignoring
# /config.toml alone let an empty one get committed once already.
/config.toml.lock
.broadcastr
# ── Runtime artifacts ────────────────────────────────────────────────────────
/logs/
!apps/gateway-admin/app/(admin)/logs/
!apps/gateway-admin/app/(admin)/logs/page.tsx
!apps/gateway-admin/components/logs/
!apps/gateway-admin/components/logs/*.tsx
!crates/lab/src/dispatch/logs/
!crates/lab/src/dispatch/logs/*.rs
*.runtime.json
/artifacts/
backups/
*.log
*.pid
*.bak
*.bak-*

