{
  "$id": "https://dinglebear.ai/schemas/verify/invariants/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog",
  "description": "Project-agnostic invariant catalog. Use `validate` before consuming bindings.",
  "type": "object",
  "properties": {
    "invariant": {
      "description": "Nonempty property catalog, including retired-ID tombstones.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Invariant"
      },
      "minItems": 1
    },
    "namespace": {
      "description": "Required prefix of every invariant ID.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "project": {
      "description": "Adopting project identity.",
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "description": "Envelope version; only version 1 is supported.",
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "namespace",
    "invariant"
  ],
  "$defs": {
    "Handles": {
      "description": "Nonempty configured handle list; semantic validation also rejects whitespace.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "Invariant": {
      "description": "One named correctness property. Constructed data must pass catalog validation.",
      "type": "object",
      "properties": {
        "checks": {
          "description": "Backend IDs mapped to adapter-local handles. No entries means uncovered.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/Handles"
            }
          }
        },
        "id": {
          "description": "Permanent namespaced identifier.",
          "$ref": "#/$defs/InvariantId"
        },
        "kind": {
          "description": "Required backend semantic capability.",
          "$ref": "#/$defs/Kind"
        },
        "model": {
          "description": "Project-defined model name.",
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "description": "Optional project annotations, not interpreted by the toolkit.",
          "type": "string"
        },
        "owner": {
          "description": "Optional project owner.",
          "type": "string"
        },
        "severity": {
          "description": "Impact of violation.",
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "description": "Lifecycle; omitted entries are active.",
          "$ref": "#/$defs/InvariantStatus",
          "default": "active"
        },
        "title": {
          "description": "Human-readable property statement.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "severity",
        "model"
      ]
    },
    "InvariantId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z]+-[0-9]{3,}$"
    },
    "InvariantStatus": {
      "description": "Invariant lifecycle, distinct from a scenario's reproduction status.",
      "oneOf": [
        {
          "description": "Property currently intended to be checked.",
          "type": "string",
          "const": "active"
        },
        {
          "description": "Property still being specified.",
          "type": "string",
          "const": "draft"
        },
        {
          "description": "Tombstone retained permanently; the ID cannot be reused.",
          "type": "string",
          "const": "retired"
        }
      ]
    },
    "Kind": {
      "description": "Semantic property category, used to reject unsupported backend bindings.",
      "oneOf": [
        {
          "description": "Nothing bad happens.",
          "type": "string",
          "const": "safety"
        },
        {
          "description": "An obligation eventually completes under declared fairness assumptions.",
          "type": "string",
          "const": "liveness"
        },
        {
          "description": "An authority or confidentiality boundary holds.",
          "type": "string",
          "const": "security"
        },
        {
          "description": "Concrete observations conform to an abstract relation.",
          "type": "string",
          "const": "refinement"
        }
      ]
    },
    "Severity": {
      "description": "Impact of violating a catalogued property.",
      "oneOf": [
        {
          "description": "Highest-impact property.",
          "type": "string",
          "const": "critical"
        },
        {
          "description": "High-impact property.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "Medium-impact property.",
          "type": "string",
          "const": "medium"
        }
      ]
    }
  }
}
