{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "bootstrap-sha": "3f0df5c142fc07bf750e3fbbe97b1d855c806134",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "refactor",
      "section": "Changed"
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "labby",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/labby-desktop/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/labby-desktop/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "apps/labby-desktop/src-tauri/Cargo.toml"
        },
        {
          "type": "generic",
          "path": "apm.yml"
        }
      ]
    }
  },
  "always-update": true
}
