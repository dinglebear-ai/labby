#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
work_root="${RUNNER_TEMP:?RUNNER_TEMP is required}/labby-n-minus-one/unix"
install_dir="$work_root/bin"
# Older releases (v1.13.3) read .env and auth.db from $HOME/.labby even when
# LABBY_HOME is set, so point both at the same directory.
user_home="$work_root/home"
labby_home="$user_home/.labby"
state_digest="$work_root/persisted-state.sha256"
pid_file="$work_root/labby.pid"
proc_root=${LABBY_N_MINUS_ONE_PROC_ROOT:-/proc}
launch_proc_root=${LABBY_N_MINUS_ONE_LAUNCH_PROC_ROOT:-$proc_root}

seed_persisted_state() {
    mkdir -p "$labby_home"
    cat >"$labby_home/config.toml" <<'EOF'
config_version = 1
[gateway]
extra_stdio_commands = ["labby"]
[[upstream]]
id = "n-minus-one"
name = "n-minus-one"
transport = "stdio"
command = "labby"
args = ["mcp"]
EOF
    printf 'LABBY_AUTH_MODE=bearer\nLABBY_MCP_HTTP_TOKEN=%064d\n' 0 >"$labby_home/.env"
    chmod 600 "$labby_home/.env"
    python3 "$repo_root/scripts/ci/n-minus-one-durable-state.py" seed "$labby_home"
    # v1.16 rewrites .env on its first start, so checksum config.toml and check
    # that the seeded token survives instead of the whole .env file.
    (cd "$labby_home" && sha256sum config.toml) >"$state_digest"
}

verify_persisted_state() {
    python3 "$repo_root/scripts/ci/n-minus-one-durable-state.py" verify "$labby_home"
    (cd "$labby_home" && sha256sum -c "$state_digest")
    grep -Fxq "LABBY_MCP_HTTP_TOKEN=$(printf '%064d' 0)" "$labby_home/.env"
    # No `gateway list` here: once the daemon runs it answers through v1.16's
    # access gate, and the config.toml checksum already proves the upstream.
}

verify_version() {
    local expected=${1#v}
    "$install_dir/labby" --version | grep -Fq "$expected"
}

verify_provenance() {
    : "${LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE:?exact candidate archive is required}"
    : "${LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE_SHA256:?exact candidate archive SHA-256 is required}"
    "$repo_root/scripts/ci/verify-and-activate-release.sh" \
        --repo "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}" --workflow release.yml \
        --ref "${GITHUB_REF:?GITHUB_REF is required}" \
        --artifact "$LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE" -- true
}

start_service() {
    local launch_identity pid identity child_start wrapper_pid wrapper_stat wrapper_tail
    launch_identity=$(mktemp "$work_root/launch-identity.XXXXXX")
    chmod 600 "$launch_identity"
    (
        wrapper_pid=$BASHPID
        wrapper_stat=$(cat "$launch_proc_root/$wrapper_pid/stat") || exit 1
        wrapper_tail=${wrapper_stat##*) }
        child_start=$(printf '%s\n' "$wrapper_tail" | awk '{print $20}')
        [[ "$child_start" =~ ^[0-9]+$ ]] || exit 1
        printf '%s\t%s\n' "$wrapper_pid" "$child_start" >"$launch_identity"
        exec env PATH="$install_dir:$PATH" HOME="$user_home" LABBY_HOME="$labby_home" \
            nohup "$install_dir/labby" serve >"$work_root/service.log" 2>&1
    ) &
    pid=$!
    for _ in {1..50}; do
        [[ -s "$launch_identity" ]] && break
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.02
    done
    IFS=$'\t' read -r wrapper_pid child_start <"$launch_identity" || true
    rm -f "$launch_identity"
    [[ "$wrapper_pid" == "$pid" && "$child_start" =~ ^[0-9]+$ ]] || {
        wait "$pid" 2>/dev/null || true
        echo "could not record launched service process identity" >&2
        return 1
    }
    for _ in {1..50}; do
        if curl -fsS http://127.0.0.1:8765/ready >/dev/null; then
            identity=$(python3 "$repo_root/scripts/ci/verified-process.py" identity \
                --pid "$pid" --proc-root "$proc_root" --executable "$install_dir/labby") && {
                [[ "${identity%%$'\t'*}" == "$child_start" ]] || break
                printf '%s\t%s\n' "$pid" "$identity" >"$pid_file"
                return
            }
        fi
        sleep 0.2
    done
    python3 "$repo_root/scripts/ci/verified-process.py" stop --pid "$pid" \
        --proc-root "$proc_root" --start "$child_start" || true
    wait "$pid" 2>/dev/null || true
    echo 'service did not become ready with the expected process identity' >&2
    return 1
}

stop_service() {
    [[ -f "$pid_file" ]] || return 0
    local pid expected_start expected_executable
    IFS=$'\t' read -r pid expected_start expected_executable <"$pid_file"
    [[ "$pid" =~ ^[0-9]+$ && "$expected_start" =~ ^[0-9]+$ && -n "$expected_executable" ]] || {
        echo "invalid persisted service process identity" >&2; return 1;
    }
    # N-1 stages run in separate shells, so the daemon started by the prior
    # stage is not this shell's child and `wait` cannot observe its exit. Wait
    # explicitly for TERM to finish so its lifecycle-lock file descriptor is
    # closed before the replacement daemon starts.
    python3 "$repo_root/scripts/ci/verified-process.py" stop --pid "$pid" \
        --proc-root "$proc_root" --start "$expected_start" --executable "$expected_executable" \
        || { echo "could not safely stop service pid $pid" >&2; return 1; }
    rm -f "$pid_file"
}

authenticated_action() {
    [[ -f "$pid_file" ]] || start_service
    token=$(sed -n 's/^LABBY_MCP_HTTP_TOKEN=//p' "$labby_home/.env")
    curl -fsS -X POST -H "Authorization: Bearer $token" \
        -H 'Content-Type: application/json' \
        --data '{"action":"help","params":{}}' \
        http://127.0.0.1:8765/v1/gateway >/dev/null
}

case "${1:-}" in
    install-previous)
        mkdir -p "$work_root"
        LABBY_INSTALL_NO_SETUP=1 LABBY_INSTALL_DIR="$install_dir" LABBY_INSTALL_VERSION="$LABBY_PREVIOUS_VERSION" \
            LABBY_ALLOW_SOURCE_FALLBACK=0 sh "$repo_root/scripts/install.sh"
        ;;
    seed-state) start_service; stop_service; seed_persisted_state ;;
    verify-previous) verify_version "$LABBY_PREVIOUS_VERSION"; verify_persisted_state ;;
    verify-provenance) verify_provenance ;;
    upgrade)
        : "${LABBY_N_MINUS_ONE_CANDIDATE_BINARY:?exact candidate binary is required}"
        : "${LABBY_N_MINUS_ONE_CANDIDATE_SHA256:?exact candidate SHA-256 is required}"
        verify_provenance
        stop_service
        HOME="$user_home" bash "$repo_root/scripts/ci/n-minus-one-recovery.sh" capture \
            "$LABBY_N_MINUS_ONE_CANDIDATE_BINARY" "$labby_home" "$work_root/recovery"
        "$repo_root/scripts/ci/verify-and-activate-release.sh" \
            --repo "$GITHUB_REPOSITORY" --workflow release.yml --ref "$GITHUB_REF" \
            --artifact "${LABBY_N_MINUS_ONE_CANDIDATE_ARCHIVE:?exact candidate archive is required}" -- \
            env LABBY_INSTALL_NO_SETUP=1 LABBY_INSTALL_DIR="$install_dir" LABBY_INSTALL_VERSION="$LABBY_CANDIDATE_VERSION" \
            LABBY_INSTALL_LOCAL_BINARY="$LABBY_N_MINUS_ONE_CANDIDATE_BINARY" \
            LABBY_INSTALL_LOCAL_SHA256="$LABBY_N_MINUS_ONE_CANDIDATE_SHA256" sh "$repo_root/scripts/install.sh"
        HOME="$user_home" LABBY_HOME="$labby_home" "$install_dir/labby" setup --bootstrap-static-owner
        ;;
    verify-candidate) verify_version "$LABBY_CANDIDATE_VERSION"; verify_persisted_state ;;
    authenticated-action) authenticated_action ;;
    restart) stop_service; start_service ;;
    verify-restart) verify_version "$LABBY_CANDIDATE_VERSION"; verify_persisted_state; authenticated_action ;;
    rollback)
        stop_service
        HOME="$user_home" bash "$repo_root/scripts/ci/n-minus-one-recovery.sh" restore \
            "${LABBY_N_MINUS_ONE_CANDIDATE_BINARY:?exact candidate binary is required}" "$labby_home" "$work_root/recovery"
        LABBY_INSTALL_DIR="$install_dir" LABBY_INSTALL_ROLLBACK=1 sh "$repo_root/scripts/install.sh"
        ;;
    verify-rollback) verify_version "$LABBY_PREVIOUS_VERSION"; verify_persisted_state ;;
    *) echo "unknown stage: ${1:-}" >&2; exit 64 ;;
esac
