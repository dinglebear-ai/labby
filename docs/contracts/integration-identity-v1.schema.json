{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Labby integration identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "product", "server_id", "product_version", "api_version", "capabilities", "auth", "streams"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "product": {"const": "labby"},
    "server_id": {"type": "string", "pattern": "^labby_[0-9a-f]{64}$"},
    "product_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "api_version": {
      "type": "object", "additionalProperties": false, "required": ["major", "minor"],
      "properties": {"major": {"const": 1}, "minor": {"const": 0}}
    },
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["modes", "issuer", "audience", "token_endpoint_origin", "principal_cache_scope", "credential_generation"],
      "properties": {
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["static_bearer", "oauth2"]}},
        "issuer": {"type": ["string", "null"]},
        "audience": {"type": ["string", "null"]},
        "token_endpoint_origin": {"type": ["string", "null"]},
        "principal_cache_scope": {"type": "null"},
        "credential_generation": {"type": "null"}
      }
    },
    "streams": {
      "type": "object", "additionalProperties": false, "required": ["transport", "resume"],
      "properties": {"transport": {"const": "none"}, "resume": {"const": "none"}}
    }
  }
}
