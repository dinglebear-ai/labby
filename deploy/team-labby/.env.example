# Immutable release images. Never deploy mutable tags.
LABBY_IMAGE=ghcr.io/dinglebear-ai/labby@sha256:replace-me
DEPOT_IMAGE=ghcr.io/dinglebear-ai/depot@sha256:replace-me

# Labby inbound OAuth and persisted-token encryption.
LABBY_PUBLIC_URL=https://replace-with-labby-ui-host.example
LABBY_AUTH_MODE=oauth
LABBY_AUTH_ADMIN_EMAIL=replace-me@example.com
LABBY_TOKEN_ENCRYPTION_KEY=replace-with-generated-key
LABBY_OAUTH_ENCRYPTION_KEY=replace-with-generated-key

# The selected Labby identity provider's non-secret settings and secret must be
# added here using the names documented in docs/runtime/OAUTH.md.

# Depot service credentials are minted after the two Depot data volumes exist.
# They let Labby reach each private backend and must never be exposed publicly.
TEAM_DEPOT_TOKEN=replace-after-bootstrap
CATALOG_DEPOT_TOKEN=replace-after-bootstrap

# One R2 bucket, with disjoint operator-owned prefixes.
DEPOT_R2_ACCOUNT_ID=replace-me
DEPOT_R2_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
DEPOT_R2_BUCKET=depot
DEPOT_R2_ACCESS_KEY_ID=replace-me
DEPOT_R2_SECRET_ACCESS_KEY=replace-me
TEAM_DEPOT_R2_PREFIX=team
CATALOG_DEPOT_R2_PREFIX=catalog
DEPOT_S3_CONCURRENCY=32

# Loopback port consumed by the host reverse proxy or Cloudflare Tunnel.
LABBY_HOST_PORT=8765
