{
  "$id": "https://dinglebear.ai/schemas/verify/scenario/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "Raw envelope. Call `validate` before replay or corpus insertion.",
  "type": "object",
  "properties": {
    "bounds": {
      "description": "Discovery bounds, not a finite-trace proof claim.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Bound"
      },
      "default": {}
    },
    "expect": {
      "description": "Required trace-wide result.",
      "$ref": "#/$defs/Expectation"
    },
    "fingerprint": {
      "description": "Optional supplied identity; validation rejects stale or forged values.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^b3:[0-9a-f]{64}$"
    },
    "initial": {
      "description": "Opaque object; missing means {}, while null is rejected by deserialization.",
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "invariant": {
      "description": "Stable catalogued invariant.",
      "$ref": "#/$defs/InvariantId"
    },
    "model": {
      "description": "Target registry key within the project.",
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "origin": {
      "description": "Retained discovery provenance.",
      "$ref": "#/$defs/Origin"
    },
    "project": {
      "description": "Adopting project identity.",
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "schema": {
      "description": "Envelope version, currently one.",
      "type": "integer",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1
    },
    "status": {
      "description": "Independent gating/reproduction status.",
      "$ref": "#/$defs/Status",
      "default": "active"
    },
    "steps": {
      "description": "Opaque transitions, interpreted only by the registered target.",
      "type": "array",
      "items": true,
      "maxItems": 10000
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "model",
    "invariant",
    "origin",
    "steps",
    "expect"
  ],
  "$defs": {
    "Bound": {
      "description": "Backend discovery bound; no nested payloads or floating-point ambiguity.",
      "anyOf": [
        {
          "description": "Signed integer bound.",
          "type": "integer",
          "format": "int64"
        },
        {
          "description": "Nonnegative bound larger than i64::MAX.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "description": "Named or symbolic bound.",
          "type": "string"
        },
        {
          "description": "Boolean exploration setting.",
          "type": "boolean"
        }
      ]
    },
    "Expectation": {
      "description": "Trace expectation, never a claim of universal verification.",
      "oneOf": [
        {
          "description": "Reproduce a concrete violation against the specified target.",
          "type": "string",
          "const": "invariant_violated"
        },
        {
          "description": "A pinned golden trace should remain valid.",
          "type": "string",
          "const": "invariant_holds"
        }
      ]
    },
    "InvariantId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z]+-[0-9]{3,}$"
    },
    "Origin": {
      "description": "Discovery metadata, retained independently of scenario identity.",
      "type": "object",
      "properties": {
        "discovered_at": {
          "description": "Caller-provided discovery timestamp; informational, not interpreted.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "How the trace was discovered.",
          "$ref": "#/$defs/OriginKind"
        },
        "reference": {
          "description": "Issue/incident reference; callers must redact sensitive data.",
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "description": "Reproduction seed, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tool_version": {
          "description": "Actual discovery tool version, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "OriginKind": {
      "description": "Provenance only; it never selects a replay implementation.",
      "oneOf": [
        {
          "description": "Stateright model checker.",
          "type": "string",
          "const": "stateright"
        },
        {
          "description": "Kani bounded verifier.",
          "type": "string",
          "const": "kani"
        },
        {
          "description": "Loom concurrency explorer.",
          "type": "string",
          "const": "loom"
        },
        {
          "description": "Shuttle schedule explorer.",
          "type": "string",
          "const": "shuttle"
        },
        {
          "description": "Alloy analyzer.",
          "type": "string",
          "const": "alloy"
        },
        {
          "description": "TLA+ backend.",
          "type": "string",
          "const": "tla"
        },
        {
          "description": "Fuzzer or property test.",
          "type": "string",
          "const": "fuzz"
        },
        {
          "description": "Redacted production incident.",
          "type": "string",
          "const": "incident"
        },
        {
          "description": "Hand-authored trace.",
          "type": "string",
          "const": "manual"
        }
      ]
    },
    "Status": {
      "description": "Reproduction lifecycle; only active scenarios gate a replay lane.",
      "oneOf": [
        {
          "description": "CI gates on matching the expectation.",
          "type": "string",
          "const": "active"
        },
        {
          "description": "Nondeterministic evidence, reported without gating.",
          "type": "string",
          "const": "quarantined"
        },
        {
          "description": "Evidence awaiting reproduction, reported without gating.",
          "type": "string",
          "const": "unreproduced"
        }
      ]
    }
  }
}
