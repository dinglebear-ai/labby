DEPOT_ACCOUNT_ID=lime-technology
DEPOT_TENANT_ID=lime-technology-team
DEPOT_TEAM_ID=skills-team

# Labby delegation verification. The issuer is Labby's exact public URL; the
# JWKS endpoint must be reachable by this container through the public route.
DEPOT_OAUTH_ISSUER=https://replace-with-labby-ui-host.example
DEPOT_OAUTH_AUDIENCE=https://team-depot.replace-with-depot-audience.example
DEPOT_OAUTH_JWKS_URI=https://replace-with-labby-ui-host.example/jwks
DEPOT_OAUTH_DELEGATION_ACTOR=replace-with-state-labby-installation-id
DEPOT_OAUTH_DELEGATION_ORGANIZATION_ID=replace-with-bound-organization-id
DEPOT_OAUTH_DELEGATION_PROJECT_ID=replace-with-bound-project-id
DEPOT_OAUTH_ORGANIZATION_POLICY_EPOCH=0
DEPOT_OAUTH_PROJECT_POLICY_EPOCH=0
# This is the shared project membership-policy epoch, not an individual
# employee membership-row generation. Keep it equal to the project policy epoch.
DEPOT_OAUTH_MEMBERSHIP_EPOCH=0
DEPOT_OAUTH_DELEGATION_MAX_LIFETIME_SECONDS=60

DEPOT_BLOB_STORE_BACKEND=s3
DEPOT_S3_PROFILE=r2
DEPOT_S3_BUCKET=replace-with-team-bucket
DEPOT_S3_PREFIX=team
DEPOT_S3_REGION=auto
DEPOT_S3_R2_ACCOUNT_ID=replace-me
DEPOT_S3_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
DEPOT_S3_ADDRESSING=path
DEPOT_S3_CREDENTIAL_SOURCE=team-labby-team-r2-secret
DEPOT_S3_ACCESS_KEY_ID=replace-with-team-prefix-scoped-key
DEPOT_S3_SECRET_ACCESS_KEY=replace-with-team-prefix-scoped-secret
DEPOT_S3_CONCURRENCY=32

# Fail closed. Do not enable DEPOT_CONTROL_PLANE_SERVICE_WRITES: writes are
# authorized only by a valid per-user delegated assertion.
DEPOT_CONTROL_PLANE_SERVICE_WRITES=false
