{
  "schemaVersion": "labby.depot-compatibility/v1",
  "labby": {
    "minimumCommit": "fecb63f15e16b87a9bde3e4c60d46191ab149fc0",
    "frontend": "gateway-admin-static-export",
    "feature": "skills",
    "surface": "authenticated-browser-http"
  },
  "depot": {
    "contractCommit": "b957e72",
    "durableSchemaGeneration": 2,
    "sessionContractVersion": 1,
    "artifactInterchange": "dinglebear.artifact-interchange/v1",
    "routes": [
      "GET /api/session",
      "GET /api/operations",
      "POST /api/operations/:operation",
      "GET /api/jobs/:id",
      "PUT /uploads/:id",
      "POST /api/artifacts/exact",
      "GET /api/artifacts/components/:artifact_id/:revision_id/:component_id"
    ]
  },
  "mountPolicy": {
    "oauthBrowserSession": "supported",
    "staticBearerBrowser": "disabled",
    "webUiAuthDisabled": "disabled",
    "noAuth": "disabled",
    "syntheticDevelopment": "disabled"
  },
  "actorPolicy": {
    "delegatedOAuth": "mutations-and-import",
    "serviceCredential": "mutations-require-labby-admin-csrf-and-depot-write-scope"
  },
  "administrationContract": {
    "version": 1,
    "operationFingerprint": {
      "algorithm": "sha256-canonical-json",
      "required": true,
      "binds": ["name", "inputSchema", "annotations", "actor", "authorityEpoch"]
    },
    "inputSchema": {
      "dialect": "labby.depot-operation-schema/v1",
      "types": ["string", "boolean", "integer", "number", "array", "object"],
      "maxProperties": 128,
      "maxRequired": 128,
      "maxEnumValues": 256,
      "maxKeyBytes": 128,
      "unsupportedBehavior": "incompatible"
    },
    "authorityStates": ["unknown", "read", "write"],
    "destructiveIntent": "single-use-actor-operation-params-epoch-bound",
    "ambiguousMutation": "indeterminate-until-reconciled"
  },
  "limits": {
    "artifactPage": 200,
    "operationCatalog": 1000,
    "responseBytes": 1048576,
    "componentBytes": 67108864,
    "packageBytes": 268435456,
    "interactiveConcurrency": 16,
    "streamConcurrency": 4,
    "queueMilliseconds": 2000
  },
  "flows": {
    "bootstrap": {"status": "supported", "operations": []},
    "bazaarBrowse": {"status": "supported", "operations": ["depot.artifacts.list"]},
    "artifactDetail": {"status": "supported", "operations": ["depot.artifacts.get"]},
    "sendToLabby": {"status": "supported", "operations": ["artifacts.import"], "exactExport": true},
    "candidateIntake": {"status": "supported", "operations": ["depot.artifacts.intake_candidate"]},
    "fork": {"status": "supported", "operations": ["depot.artifacts.fork"]},
    "publication": {"status": "supported", "operations": ["depot.artifacts.set_publication"]},
    "license": {"status": "supported", "operations": ["depot.artifacts.set_license"]},
    "archive": {"status": "supported", "operations": ["depot.uploads.create", "depot.uploads.get", "depot.uploads.delete", "depot.ingest.start"]},
    "delete": {"status": "supported", "operations": ["depot.skills.delete", "depot.bundles.delete"]},
    "browserCredentialAdministration": {"status": "supported", "operations": ["depot.tokens.list", "depot.tokens.create", "depot.tokens.revoke"]},
    "maintenance": {"status": "supported", "operationPrefix": "depot.maintenance."}
  }
}
