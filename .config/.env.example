# Labby environment-only settings and credentials.
#
# Copy selected entries to $LABBY_HOME/.env (normally ~/.labby/.env); Labby does
# not read a checkout-local .env. Existing process variables override dotenv.
# Keep this file as an example: never commit real keys or tokens.
# Prefer config.toml for product preferences that have a TOML equivalent.
# A few process-only bootstrap variables below must be set by the service
# manager or shell before Labby starts; $LABBY_HOME/.env is too late for them.

# ── Inbound authentication and durable secrets ─────────────────────────────
# Required for HTTP bearer mode.
# LABBY_MCP_HTTP_TOKEN=
# Required for OAuth mode; generate a 32-byte key (64 hex characters or 43
# base64url characters) and retain it across restarts.
# LABBY_TOKEN_ENCRYPTION_KEY=
# Google OAuth provider credentials (OAuth mode with provider google).
# LABBY_GOOGLE_CLIENT_ID=
# LABBY_GOOGLE_CLIENT_SECRET=
# Authelia OAuth provider credential (provider selection and issuer are [auth]
# preferences in config.toml).
# LABBY_AUTHELIA_CLIENT_SECRET=
# Optional upstream OAuth encryption for native stdio and gateway connections.
# LABBY_OAUTH_ENCRYPTION_KEY=
# Bootstrap admission secret, when bootstrap authorization is configured.
# LABBY_AUTH_BOOTSTRAP_SECRET=
# Optional HMAC secret for activity actor identifiers.
# LABBY_ACTOR_KEY_SECRET=
# Recovery HMAC key is a path to an external, operator-held secret file. Store
# the file outside LABBY_HOME and outside backup bundles.
# LABBY_RECOVERY_KEY_PATH=/secure/labby-recovery.key

# ── Client and proxy credentials ────────────────────────────────────────────
# Default bearer secret for the direct stdio proxy; [proxy].bearer_token_env
# may select a different environment variable name.
# LABBY_PROXY_BEARER_TOKEN=
# Explicit remote CLI/stdio daemon target; this is a client-only selector.
# LABBY_SERVER_URL=https://labby.example.com
# CLAUDE_PLUGIN_OPTION_SERVER_URL and CLAUDE_PLUGIN_OPTION_API_TOKEN are paired
# invocation-scoped plugin inputs, supplied by the plugin host.
# Native stdio OAuth uses an ephemeral callback port by default.
# LABBY_STDIO_OAUTH_CALLBACK_PORT=0

# ── Agent execution and OpenAPI credentials ─────────────────────────────────
# OpenAI-compatible Agent provider; URL must be reachable from Labby's runtime.
# LABBY_PHOENIX_OPENAI_BASE_URL=http://127.0.0.1:43871/v1
# LABBY_PHOENIX_OPENAI_API_KEY=
# An [[openapi.specs]] label selects one dynamic credential key. For a spec
# labeled petstore, TOKEN takes precedence over API_KEY when both are set.
# OPENAPI_PETSTORE_TOKEN=
# OPENAPI_PETSTORE_API_KEY=

# ── Gateway, Depot, and service credentials ────────────────────────────────
# [[upstream]], [[artifacts.sources]], and Depot providers select secret key
# names in config.toml. Set each referenced key here, never its value in TOML.
# LABBY_DEPOT_CATALOG_READ_TOKEN=
# LABBY_DEPOT_TEAM_TOKEN=
# LABBY_DEPOT_AUTHORITY_TOKEN=
# LABBY_DEPOT_AUTHORITY_SIGNING_KEY=
# Legacy Depot env configuration; use [depot] / [[depot.providers]] instead.
# LABBY_DEPOT_ENABLED=1
# LABBY_DEPOT_URL=https://depot.example.com
# LABBY_DEPOT_TOKEN=
# Built-in service endpoints and credentials use SERVICE_URL, SERVICE_API_KEY,
# SERVICE_TOKEN, SERVICE_USERNAME, and SERVICE_PASSWORD. Additional instances
# use SERVICE_LABEL_URL and corresponding credential names.
# UNIFI_URL=https://192.0.2.1
# UNIFI_API_KEY=
# APPRISE_URL=http://localhost:8001
# APPRISE_TOKEN=
# UNRAID_URL=https://tower.local/graphql
# UNRAID_API_KEY=
# OPENAI_API_KEY=

# ── Dev Container restricted Incus connection ──────────────────────────────
# Configure all five paths/values together; certificate files must be private.
# LABBY_DEV_CONTAINER_INCUS_URL=https://tootie:8443
# LABBY_DEV_CONTAINER_INCUS_PROJECT=labby-dev-containers
# LABBY_DEV_CONTAINER_INCUS_CLIENT_CERT=/home/labby/.labby/incus/client.crt
# LABBY_DEV_CONTAINER_INCUS_CLIENT_KEY=/home/labby/.labby/incus/client.key
# LABBY_DEV_CONTAINER_INCUS_SERVER_CERT=/home/labby/.labby/incus/server.crt

# ── Optional runner and gateway process tuning ─────────────────────────────
# Code Mode direct process is the default. Microsandbox requires a qualified
# executable and an already-cached image pinned by immutable digest.
# LABBY_CODE_MODE_RUNNER_BACKEND=microsandbox
# LABBY_CODE_MODE_MICROSANDBOX_EXE=/absolute/path/to/msb
# LABBY_CODE_MODE_MICROSANDBOX_IMAGE=debian@sha256:<64-hex-digits>
# LABBY_CODE_MODE_MICROSANDBOX_MAX_RUNNERS=4
# LABBY_CODE_MODE_MICROSANDBOX_HELPER_TIMEOUT_MS=5000
# LABBY_CODE_MODE_POOL_SIZE=2
# LABBY_CODE_MODE_POOL_MAX_OVERFLOW=8
# LABBY_CODE_MODE_POOL_RECYCLE_AFTER=100
# LABBY_CODE_MODE_RUNNER_EXE=/absolute/path/to/labby-code-mode-runner
# LABBY_GW_UPSTREAM_MAX_IN_FLIGHT=8
# LABBY_GW_UPSTREAM_STDERR=debug
# LABBY_TAILSCALE_BIN=tailscale
# Disable the local Code Mode journal or usage database when required.
# LABBY_CODE_MODE_JOURNAL_DISABLED=1
# LABBY_GATEWAY_USAGE_DISABLED=1

# ── Integrated trusted-host Unix socket mode ────────────────────────────────
# Requires Unix-socket transport plus a configured peer UID/GID policy.
# LABBY_INTEGRATED_TRUSTED_HOST=1
# LABBY_TRUSTED_HOST_CURRENT_KEY_ID=current
# LABBY_TRUSTED_HOST_CURRENT_PUBLIC_KEY=<ed25519-base64url-public-key>
# LABBY_TRUSTED_HOST_AUTHORITY_GENERATION=1
# Optional rotation overlap; provide both previous-key fields together.
# LABBY_TRUSTED_HOST_PREVIOUS_KEY_ID=previous
# LABBY_TRUSTED_HOST_PREVIOUS_PUBLIC_KEY=<ed25519-base64url-public-key>
# LABBY_CORE_PROVIDER_SOCKET_PATH=/run/labby/core-provider.sock

# ── Provisioning and operator actions ───────────────────────────────────────
# Provisioning-only Tailscale join key and hostname. Tailnet preference may be
# set in config.toml instead of TAILSCALE_TAILNET.
# TS_AUTHKEY=
# LABBY_TAILSCALE_HOSTNAME=labby
# Approval document for an access-store migration; see docs/access-control/MIGRATION.md.
# LABBY_ACCESS_MIGRATION_EVIDENCE=/run/labby/access-migration-v8.json

# ── Process-only bootstrap controls ─────────────────────────────────────────
# Set these in the real process environment (shell/systemd), not only .env:
# tracing initializes before dotenv is loaded.
# LABBY_LOG_DIR=/var/log/labby
# LABBY_LOG_COLOR=never
# RUST_LOG=labby=debug,warn
# LABBY_LOG=labby=debug,warn
# LABBY_LOG_FORMAT=json
# Select the absolute installation state root before startup.
# LABBY_HOME=/home/labby/.labby
