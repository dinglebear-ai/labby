{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinglebear.ai/schemas/labby/code-mode-call-error-v1.json",
  "title": "Labby Code Mode Call Error",
  "type": "object",
  "required": [
    "contract_version",
    "kind",
    "message",
    "origin",
    "recovery",
    "side_effects"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "pattern": "^.+::.+$"
    },
    "origin": {
      "enum": [
        "code_mode",
        "tool_execution",
        "upstream_transport",
        "validation",
        "policy",
        "budget"
      ]
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    },
    "side_effects": {
      "enum": [
        "none_expected",
        "possible",
        "unknown"
      ]
    },
    "original_kind": {
      "type": "string"
    },
    "cause": {
      "type": "string"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "recovery": {
      "type": "object",
      "required": [
        "action",
        "same_arguments",
        "guidance"
      ],
      "properties": {
        "action": {
          "enum": [
            "revise_and_retry",
            "retry_later",
            "reauthenticate",
            "confirm",
            "rediscover",
            "reduce_work",
            "start_dependency",
            "inspect_and_escalate",
            "do_not_retry"
          ]
        },
        "same_arguments": {
          "enum": [
            "safe",
            "conditional",
            "discouraged",
            "never"
          ]
        },
        "guidance": {
          "type": "string",
          "minLength": 1
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "properties": {
        "read_only_hint": {
          "type": "boolean"
        },
        "destructive_hint": {
          "type": "boolean"
        },
        "idempotent_hint": {
          "type": "boolean"
        },
        "open_world_hint": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {}
        },
        "structured_content": {},
        "parsed_error": {},
        "omitted_content_blocks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
