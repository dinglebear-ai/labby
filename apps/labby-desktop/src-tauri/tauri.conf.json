{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": []
  },
  "build": {
    "beforeBuildCommand": "pnpm vite:build",
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Labby provides a native desktop shell for the canonical Labby Control Plane.",
    "shortDescription": "Native Labby Control Plane",
    "targets": [
      "deb",
      "rpm",
      "app",
      "dmg",
      "msi",
      "nsis"
    ]
  },
  "identifier": "tv.tootie.labby.desktop",
  "productName": "Labby",
  "version": "0.1.0"
}
