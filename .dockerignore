# ── VCS ──────────────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Secrets (NEVER ship into image) — ONLY .env.example allowed ─────────────
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example

# ── Rust build artifacts ─────────────────────────────────────────────────────
/target/
**/*.rs.bk
*.profraw
*.profdata

# ── Runtime artifacts ────────────────────────────────────────────────────────
logs/
backups/
*.log
*.pid
*.bak
*.bak-*
data/

# ── Caches ───────────────────────────────────────────────────────────────────
.cache/

# ── AI tooling / local state ─────────────────────────────────────────────────
.claude/
.omc/
.lavra/
.beads/
.dolt/
.serena/
.worktrees/
.full-review/
.full-review-archive-*
.bivvy
.superpowers/
.codex
.gemini
.beads-credential-key
*.db
*.db-shm
*.db-wal
settings.local.json
CLAUDE.md.local

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.cursor/
.windsurf/
.1code/
.idea/
.zed/
*.iml
*.swp
*.swo
*~
.emdash.json

# ── OS generated ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Documentation (not needed in image) ──────────────────────────────────────
docs/
!docs/
!docs/generated/
!docs/generated/env-reference.json
!docs/contracts/
!docs/contracts/**
README.md
LICENSE*
AGENTS.md
GEMINI.md
CLAUDE.md
.docs/

# ── Plugin / scaffolding noise (not needed in image) ─────────────────────────
.agents/
.claude-plugin/
.codex-plugin/
.github/
agents/
commands/
hooks/
plugins/
!plugins/
!plugins/labby/
!plugins/labby/skills/
!plugins/labby/skills/using-labby/
!plugins/labby/skills/using-labby/**
!plugins/labby/skills/creating-snippets/
!plugins/labby/skills/creating-snippets/**
skills/

# ── Docker self-references ───────────────────────────────────────────────────
config/Dockerfile
config/Dockerfile.fast
config/docker-compose.override.yml.example
config/config.example.toml
config/config.toml
docker-compose.yaml
docker-compose.yml
.dockerignore

# ── Repo-specific ────────────────────────────────────────────────────────────
*.key
*.pem
*.cert
config.local.toml

# ── Frontend apps ────────────────────────────────────────────────────────────
# The Rust action catalog embeds selected Gateway Admin TypeScript sources at
# compile time, so the image build needs the app source as well as its export.
apps/*
!apps/gateway-admin/
apps/gateway-admin/node_modules/
apps/gateway-admin/.next/
# Root ignore patterns do not cover nested app files. Preserve the complete
# private/runtime/cache policy recursively after reopening the app directory.
apps/gateway-admin/**/.env
apps/gateway-admin/**/.env.*
apps/gateway-admin/**/*.env
apps/gateway-admin/**/*.env.*
!apps/gateway-admin/**/.env.example
apps/gateway-admin/**/*.key
apps/gateway-admin/**/*.pem
apps/gateway-admin/**/*.cert
apps/gateway-admin/**/config.local.toml
apps/gateway-admin/**/settings.local.json
apps/gateway-admin/**/*.db
apps/gateway-admin/**/*.db-shm
apps/gateway-admin/**/*.db-wal
apps/gateway-admin/**/*.log
apps/gateway-admin/**/.cache/
apps/gateway-admin/**/.git/
apps/gateway-admin/**/.claude/
apps/gateway-admin/**/.codex/
apps/gateway-admin/**/node_modules/
apps/gateway-admin/**/.next/
apps/gateway-admin/**/.gitignore
apps/gateway-admin/**/.gitattributes
