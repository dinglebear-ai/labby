    {"name": "reject_replayed_assertion", "assertion": {"jti": "reused", "typ": "unraid+delegated-actor+jwt", "iss": "unraid-core", "aud": "labby-trusted-host", "alg": "EdDSA"}, "response": {"error": "assertion_replayed"}},
    {"name": "reject_oversize_before_allocation", "request_bytes": 1048577, "response": {"error": "request_too_large"}}
