{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinglebear.ai/schemas/verify/invariants/1",
  "title": "Verification invariant catalog",
  "description": "Draft. Project-agnostic catalog of named correctness properties. Generated from verify-core types once M1 lands; hand-written here as a design draft.",
  "type": "object",
  "required": ["schema", "project", "namespace", "invariant"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$",
      "description": "Identifier prefix, e.g. LABBY, DRIVE, CORE. Not interpreted by the tooling."
    },
    "invariant": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "required": ["id", "title", "kind", "severity", "model"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[A-Z]+-[0-9]{3,}$",
          "description": "Globally unique and permanently stable. Retirement never frees an id."
        },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["safety", "liveness", "security", "refinement"] },
        "severity": { "enum": ["critical", "high", "medium"] },
        "model": {
          "type": "string",
          "description": "Target model name; resolved against the project's target registry."
        },
        "owner": { "type": "string" },
        "status": { "enum": ["active", "draft", "retired"], "default": "active" },
        "notes": { "type": "string" },
        "checks": { "$ref": "#/$defs/checks" }
      }
    },
    "checks": {
      "type": "object",
      "description": "Backend handles, not file paths. An unresolved handle is a hard error, never silent uncovered status. An absent backend key means this invariant is not claimed by that backend.",
      "additionalProperties": false,
      "properties": {
        "stateright": { "$ref": "#/$defs/handles" },
        "kani": { "$ref": "#/$defs/handles" },
        "loom": { "$ref": "#/$defs/handles" },
        "shuttle": { "$ref": "#/$defs/handles" },
        "alloy": { "$ref": "#/$defs/handles" },
        "tla": { "$ref": "#/$defs/handles" }
      }
    },
    "handles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
