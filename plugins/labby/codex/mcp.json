{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "labby": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dinglebear/labby",
        "mcp"
      ],
      "env": {
        "LABBY_MCP_NO_BUNDLED_SKILLS": "1"
      }
    }
  }
}
