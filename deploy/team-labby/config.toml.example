[mcp]
transport = "http"
host = "127.0.0.1"
port = 8765

[[upstream]]
name = "team-depot"
transport = "http"
url = "http://127.0.0.1:4100/mcp"
bearer_token_env = "LABBY_DEPOT_PROVIDER_TEAM_LOCAL_TOKEN"
proxy_resources = true
proxy_prompts = true
proxy_skills = true

[[upstream]]
name = "catalog-depot"
transport = "http"
url = "http://127.0.0.1:4101/mcp"
bearer_token_env = "LABBY_DEPOT_PROVIDER_CATALOG_LOCAL_TOKEN"
proxy_resources = true
proxy_prompts = true
proxy_skills = true

[[upstream]]
name = "linear"
transport = "http"
url = "https://notification-worker.unraid-workers.workers.dev/mcp/linear"

[upstream.oauth]
mode = "authorization_code_pkce"

[upstream.oauth.registration]
strategy = "dynamic"

[[protected_mcp_routes]]
name = "team-linear"
enabled = true
public_host = "replace-with-public-mcp-host.example"
public_path = "/mcp/linear"
scopes = ["lab:read", "lab"]

[protected_mcp_routes.target]
kind = "gateway_subset"
project_id = "replace-with-bound-project-id"
upstreams = ["team-depot", "catalog-depot", "linear"]
# Only context-free services may be listed here. Caller-bound services
# (`artifacts`, `access`, `agents`, `tasks`, `dev_containers`, `projects`,
# `stash`) and HTTP-only services (`bundles`, `jobs`, `sources`, `uploads`)
# are rejected at startup with "unknown gateway_subset service". Team Depot
# publishing does not need `artifacts`: the route-owned `depot_publish` tool
# is attached automatically whenever `upstreams` includes `team-depot`.
services = ["gateway", "setup", "snippets"]
expose_code_mode = true

[[protected_mcp_routes]]
name = "team-depot-publish"
enabled = true
public_host = "replace-with-public-mcp-host.example"
public_path = "/mcp/team-depot"
scopes = ["lab:read", "lab"]

[protected_mcp_routes.target]
kind = "gateway_subset"
project_id = "replace-with-bound-project-id"
upstreams = ["team-depot", "catalog-depot"]
services = ["gateway", "setup", "snippets"]
expose_code_mode = true

[depot.publish]
route_id = "team-depot-publish"
project_id = "replace-with-bound-project-id"

[depot]
read_project_id = "replace-with-bound-project-id"
public_enabled = true
legacy_migrated = true

[[depot.local_providers]]
id = "team-local"
name = "Team Depot"
endpoint = "http://127.0.0.1:4100/"
bearer_token_env = "LABBY_DEPOT_PROVIDER_TEAM_LOCAL_TOKEN"

[[depot.local_providers]]
id = "catalog-local"
name = "Catalog Depot"
endpoint = "http://127.0.0.1:4101/"
bearer_token_env = "LABBY_DEPOT_PROVIDER_CATALOG_LOCAL_TOKEN"
