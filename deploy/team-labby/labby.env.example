# Labby inbound OAuth and persisted-token encryption.
LABBY_PUBLIC_URL=https://replace-with-labby-ui-host.example
LABBY_AUTH_MODE=oauth
LABBY_AUTH_ADMIN_EMAIL=replace-me@example.com
LABBY_AUTH_ALLOWED_EMAIL_DOMAINS=lime-technology.com
LABBY_TOKEN_ENCRYPTION_KEY=replace-with-generated-key
LABBY_OAUTH_ENCRYPTION_KEY=replace-with-generated-key

# Add exactly one supported identity provider using the variable names in
# docs/runtime/OAUTH.md. Keep its client secret in this file.

# These are deliberately read-only service credentials. The host-managed
# Discover providers and MCP upstreams use distinct env references so browser
# configuration can never repoint or replace them. Labby replaces the team
# read token with a short-lived per-user assertion for delegated writes.
LABBY_DEPOT_PROVIDER_TEAM_LOCAL_TOKEN=replace-after-bootstrap
LABBY_DEPOT_PROVIDER_CATALOG_LOCAL_TOKEN=replace-after-bootstrap

# Direct Depot control-plane connection and its server-owned delegation target.
# Every value must exactly match the corresponding team-depot.env setting.
LABBY_DEPOT_ENABLED=1
LABBY_DEPOT_URL=http://127.0.0.1:4100
LABBY_DEPOT_TOKEN=replace-with-the-same-value-as-LABBY_DEPOT_PROVIDER_TEAM_LOCAL_TOKEN
LABBY_DEPOT_DELEGATION_AUDIENCE=https://team-depot.replace-with-depot-audience.example
LABBY_DEPOT_DELEGATION_DEPLOYMENT_ID=team-depot
LABBY_DEPOT_DELEGATION_ACCOUNT_ID=lime-technology
LABBY_DEPOT_DELEGATION_TENANT_ID=lime-technology-team
LABBY_DEPOT_DELEGATION_TEAM_ID=skills-team
