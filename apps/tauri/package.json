{
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "vite": "^8.1.6"
  },
  "name": "labby-desktop",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "scripts": {
    "build": "python3 ../../scripts/ci/verify_glib_backport.py --prepare && tauri build",
    "dev": "python3 ../../scripts/ci/verify_glib_backport.py --prepare && tauri dev",
    "preview": "vite preview",
    "verify": "pnpm install --frozen-lockfile && pnpm vite:build",
    "vite:build": "vite build",
    "vite:dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "prepare:glib": "python3 ../../scripts/ci/verify_glib_backport.py --prepare"
  },
  "type": "module",
  "version": "2.6.2",
  "license": "AGPL-3.0-only",
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2"
    }
  }
}
